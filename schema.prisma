generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // SQLite uchun "sqlite" va DATABASE_URL="file:./dev.db"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}
